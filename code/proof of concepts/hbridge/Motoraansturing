// Test H-brug DRV8833 met 2 motoren: elk kanaal vooruit, daarna beide vooruit
// Wielen los van de grond houden. STBY en VM op 5V (test via USB), GND gemeenschappelijk.
// Beide wielen moeten bij "Beide vooruit" naar de voorkant van de robot draaien.

const int LINKS_1  = 5,  LINKS_2  = 6;    // AIN1, AIN2 (motor links, AO1/AO2)
const int RECHTS_1 = 9,  RECHTS_2 = 10;   // BIN1, BIN2 (motor rechts, BO1/BO2)
const int SPEED = 80;

void stopAlles() {
  analogWrite(LINKS_1, 0);  analogWrite(LINKS_2, 0);
  analogWrite(RECHTS_1, 0); analogWrite(RECHTS_2, 0);
}

void setup() {
  Serial.begin(115200);
  pinMode(LINKS_1, OUTPUT);  pinMode(LINKS_2, OUTPUT);
  pinMode(RECHTS_1, OUTPUT); pinMode(RECHTS_2, OUTPUT);
}

void loop() {
  Serial.println("Links vooruit");
  analogWrite(LINKS_1, SPEED); analogWrite(LINKS_2, 0);
  delay(2000); stopAlles(); delay(1000);

  Serial.println("Rechts vooruit");
  analogWrite(RECHTS_1, SPEED); analogWrite(RECHTS_2, 0);
  delay(2000); stopAlles(); delay(1000);

  Serial.println("Beide vooruit");
  analogWrite(LINKS_1, SPEED); analogWrite(LINKS_2, 0);
  analogWrite(RECHTS_1, SPEED); analogWrite(RECHTS_2, 0);
  delay(2000); stopAlles(); delay(3000);
}
