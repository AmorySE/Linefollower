
#include <Arduino.h>
#include <SoftwareSerial.h>

// ===== Pinnen =====
const byte rxPin = 11;  // RX Arduino <- TX HC-06
const byte txPin = 12;  // TX Arduino -> RX HC-06

// ===== Bluetooth communicatie =====
SoftwareSerial BTSerial(rxPin, txPin); // RX, TX

// ===== Variabelen =====
char DataFromPhone;
char DataFromPC;

void setup() {

  // Seriele communicatie met de pc
  Serial.begin(9600);

  // Seriele communicatie met de HC-06
  BTSerial.begin(9600);

  Serial.println("HC-06 Bluetooth test gestart!");
  Serial.println("Verbind de smartphone met de HC-06.");
}

void loop() {

  // ===== Smartphone naar PC =====
  // Controleer of er gegevens binnenkomen via Bluetooth
  if (BTSerial.available() > 0) {

    DataFromPhone = BTSerial.read();

    // Stuur ontvangen gegevens door naar de pc
    Serial.write(DataFromPhone);
  }

  // ===== PC naar Smartphone =====
  // Controleer of er gegevens binnenkomen via USB
  if (Serial.available() > 0) {

    DataFromPC = Serial.read();

    // Stuur ontvangen gegevens door naar de smartphone
    BTSerial.write(DataFromPC);
  }
}
